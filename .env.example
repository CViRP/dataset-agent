# Copy to .env. All paths are relative to the server working directory.
DATA_AGENT_DATA_DIR=.data
DATA_AGENT_PROVIDER=offline
# Use provider=openai or anthropic and set its model when you have a key.
DATA_AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional locally; REQUIRED by Docker Compose and any off-loopback binding.
# JSON map from your own API tokens to project IDs (not an LLM API key).
# DATA_AGENT_API_KEYS={"replace-with-a-long-random-token":"my-project"}
# Docker Compose publishes the API on localhost at this port.
# DATA_AGENT_PORT=8000
DATA_AGENT_MAX_UPLOAD_MB=25
DATA_AGENT_TOOL_TIMEOUT_SECONDS=30
DATA_AGENT_MAX_AGENT_STEPS=12
DATA_AGENT_MAX_WORKERS=2
# Exact browser origins; empty by default. Restart the API after changing this.
# For the Flutter web frontend on port 8080:
DATA_AGENT_BROWSER_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
