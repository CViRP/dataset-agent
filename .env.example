# Copy to .env. All paths are relative to the server working directory.
DATA_AGENT_DATA_DIR=.data
DATA_AGENT_PROVIDER=offline
# Use provider=openai or anthropic and set its model when you have a key.
DATA_AGENT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: JSON map from strong API tokens to project IDs. Required off loopback.
# DATA_AGENT_API_KEYS={"replace-with-a-long-random-token":"my-project"}
DATA_AGENT_MAX_UPLOAD_MB=25
DATA_AGENT_TOOL_TIMEOUT_SECONDS=30
DATA_AGENT_MAX_AGENT_STEPS=12
DATA_AGENT_MAX_WORKERS=2
